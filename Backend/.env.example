# Copy to .env and fill in real values. Never commit the real .env file.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (SQL, via SQLAlchemy) ---------------------------------------
# SQLite is fine for local dev (no server to run). Point this at
# postgresql://user:pass@host/dbname (or similar) in production.
DATABASE_URL=sqlite:///telespy.db

# --- Redis (JWT blocklist + MFA OTP cache) ---------------------------------
REDIS_URL=redis://localhost:6379/0

# --- JWT -----------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
# Short-lived token issued after password check, before OTP is confirmed.
JWT_MFA_TOKEN_EXPIRES_MINUTES=5

# --- Field-level encryption -----------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY encrypts SIM ICCID/MSISDN, extensions, and the
# employee<->SIM/extension mapping at rest.
FIELD_ENCRYPTION_KEY=
# BLIND_INDEX_KEY is a *separate* secret used only to build deterministic,
# one-way search fingerprints for the encrypted fields above (so the DB can
# still index/search/enforce-uniqueness on them without storing plaintext).
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
BLIND_INDEX_KEY=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of exact frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000

# --- Outbound email (MFA OTP + password reset) ------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=TeleSpy <no-reply@telespy.local>
# When true, OTP/reset emails are printed to the console log instead of sent.
# Handy for local dev without real SMTP creds.
MAIL_SUPPRESS_SEND=true

# --- App-level policy --------------------------------------------------------
DPA_KE_POLICY_VERSION=2026-01
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
MFA_OTP_EXPIRES_MINUTES=5
