# Copy to .env in this same folder and fill in real values.
# Never commit the real .env file (gitignored, same as every other .env in
# this project).

# --- Cisco CUCM (batch, SFTP pull — see cucm_sftp_fetch.py) ---------------
# The SFTP endpoint that receives CUCM's CDR Repository Manager exports
# (CUCM's own repository, or an intermediary file server it pushes to).
# Configure the matching push interval on the CUCM side under
# Cisco Unified Serviceability > Tools > CDR Management.
CUCM_SFTP_HOST=
CUCM_SFTP_PORT=22
CUCM_SFTP_USER=
# Either a password, or a private key file path (key wins if both are set).
CUCM_SFTP_PASSWORD=
CUCM_SFTP_KEY_PATH=
CUCM_SFTP_REMOTE_DIR=/CDR

# --- Avaya CM / Aura / IP Office (real-time, TCP listener — see
# avaya_cdr_listener.py) ---------------------------------------------------
# This machine's IP:port that Avaya's CDR adjunct link connects TO —
# configure the matching values on the Avaya system (`change ip-services`
# for the link, `change system-parameters cdr` for the record format).
AVAYA_LISTEN_HOST=0.0.0.0
AVAYA_LISTEN_PORT=9000
# How often (seconds) / how many records before the in-memory buffer is
# flushed to a file in cdr_incoming/, whichever comes first.
AVAYA_FLUSH_SECONDS=60
AVAYA_FLUSH_RECORDS=500
# "delimited" (default) or "fixed_width" — MUST match what's actually
# administered on the Avaya system (`display system-parameters cdr`).
AVAYA_CDR_FORMAT=delimited
AVAYA_CDR_DELIMITER=,
# Comma-separated field names, in the order they appear in one CDR record.
AVAYA_CDR_FIELD_ORDER=date,orig_time,duration_sec,orig,dest,condition_code
# Only used when AVAYA_CDR_FORMAT=fixed_width: name:start:end per field
# (0-indexed, end-exclusive), comma-separated, e.g.:
#   AVAYA_CDR_FIELD_SPEC=date:0:6,orig_time:6:10,duration_sec:10:16,orig:16:23,dest:23:33
AVAYA_CDR_FIELD_SPEC=

# --- Generic SFTP-drop vendor (batch — see generic_sftp_fetch.py) ---------
# Any other PBX/gateway/UCaaS vendor that just drops CSV/text files via
# SFTP. Add its column names to RAW_COLUMNS in
# ML/preprocessing/run_preprocessing.py if they don't already match.
GENERIC_SFTP_VENDOR_LABEL=vendor
GENERIC_SFTP_HOST=
GENERIC_SFTP_PORT=22
GENERIC_SFTP_USER=
GENERIC_SFTP_PASSWORD=
GENERIC_SFTP_KEY_PATH=
GENERIC_SFTP_REMOTE_DIR=/
