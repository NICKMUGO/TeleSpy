# Production settings for the Azure VM. Copy to /opt/telespy/.env on the
# server and fill in every <…> value (deploy/README.md, step 3). Never
# commit the real file. Generate each secret separately:
#     openssl rand -base64 32      (or -hex 32 where noted)

# --- Read by docker compose itself ------------------------------------------
# The public hostname Caddy serves and gets an HTTPS certificate for: the
# VM's Azure DNS name (printed by azure-provision.sh) and/or your own
# domain; list several with ", " and Caddy serves (and certifies) each.
SITE_DOMAIN=telespy.co.ke, <dns-label>.<region>.cloudapp.azure.com
POSTGRES_PASSWORD=<openssl rand -hex 24>

# --- Read by the API (and the ML jobs, for DATABASE_URL) --------------------
ASPNETCORE_ENVIRONMENT=Production
SECRET_KEY=<openssl rand -base64 32>

# Same password as POSTGRES_PASSWORD above; "db" is the compose service.
DATABASE_URL=postgresql://telespy:<POSTGRES_PASSWORD>@db:5432/telespy
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=<openssl rand -base64 32>
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
# Signed out after this many days without using the app...
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# ...or this many days after signing in, whichever comes first.
SESSION_MAX_DAYS=90
JWT_MFA_TOKEN_EXPIRES_MINUTES=5

# Encrypts personal data at rest. Back these two up somewhere safe: lose
# them and the encrypted columns can't be read again.
FIELD_ENCRYPTION_KEY=<openssl rand -base64 32>
BLIND_INDEX_KEY=<openssl rand -hex 32>

# Push notifications. Make a key pair once with
#   docker compose run --rm api --vapid-keys     (or: dotnet run -- --vapid-keys)
# and paste both lines here. Leave empty to keep notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<an admin email>

# The site's own origin (password-reset links are built from the first one).
FRONTEND_ORIGINS=https://<SITE_DOMAIN>

# Sign-in needs an emailed one-time code, so mail must really send in
# production. Azure blocks outbound port 25; 587 works. Gmail example:
# turn on 2-Step Verification, create an App Password, use it below.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=<you@gmail.com>
MAIL_PASSWORD=<16-character app password>
MAIL_DEFAULT_SENDER=TeleSpy <you@gmail.com>
MAIL_SUPPRESS_SEND=false

DPA_KE_POLICY_VERSION=2026-01
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
MFA_OTP_EXPIRES_MINUTES=5

# The first Admin, created on the API's first start and emailed a
# set-password link. Ignored once an Admin exists.
BOOTSTRAP_ADMIN_EMAIL=<admin@example.com>
BOOTSTRAP_ADMIN_NAME=System Administrator
